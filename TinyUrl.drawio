          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="dbnote" value="urls and users typically live in the primary DB (NoSQL for horizontal scale, or SQL at moderate scale). click_analytics is best kept in a separate time-series store for write-heavy append-only logging." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=11;align=left;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="330" width="320" height="90" as="geometry" />
