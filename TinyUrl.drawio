<mxfile host="app.diagrams.net" modified="2026-07-31T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">

  <!-- PAGE 1: REQUIREMENTS -->
  <diagram name="1. Requirements" id="page-requirements">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="TinyURL — Requirements" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="func_header" value="Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="func_body" value="1. Given a long URL, generate a unique short URL&#10;2. Redirect users from short URL to original long URL&#10;3. Users can optionally choose a custom alias&#10;4. Links can have an expiration date (default if unspecified)&#10;5. (Optional) Analytics — click counts, timestamps, referrers&#10;6. (Optional) User accounts to manage their own links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="480" height="180" as="geometry" />
        </mxCell>

        <mxCell id="nonfunc_header" value="Non-Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nonfunc_body" value="- High availability — redirection is on the critical path&#10;- Low latency — redirects in a few milliseconds&#10;- High reliability — short URL always maps to same long URL&#10;- Scalability — must handle heavy read traffic&#10;- Security — short URLs should not be easily guessable&#10;- Read:Write traffic is heavily skewed (~100:1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="480" height="180" as="geometry" />
        </mxCell>

        <mxCell id="short_header" value="Short Code Generation Strategy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="short_body" value="Base62 [a-zA-Z0-9], 7 characters -&gt; 62^7 ≈ 3.5 trillion combinations (comfortably covers billions of URLs).&#10;Preferred approach: a Key Generation Service (KGS) pre-generates and stores random unique 7-char keys in a pool; app servers pull unused keys — avoids collision checks and predictability on the write path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="1000" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 2: ESTIMATION -->
  <diagram name="2. Back of the Envelope" id="page-estimation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title2" value="TinyURL — Back-of-the-Envelope Estimation" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="assum" value="Assumptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="assum_body" value="100M new URLs created per month  |  Read:Write ratio ≈ 100:1 -&gt; ~10B redirects per month" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1000" height="40" as="geometry" />
        </mxCell>

        <mxCell id="traffic" value="Traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="traffic_body" value="Writes/sec = 100M / (30 x 24 x 3600) ≈ 40 writes/sec&#10;Reads/sec = 40 x 100 ≈ 4,000 reads/sec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="480" height="80" as="geometry" />
        </mxCell>

        <mxCell id="storage" value="Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="storage_body" value="~500 bytes/record. Retain 5 years: 100M/month x 60 months = 6B records&#10;Total storage ≈ 6B x 500 bytes ≈ ~3 TB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="480" height="80" as="geometry" />
        </mxCell>

        <mxCell id="codelen" value="Short Code Length" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="codelen_body" value="Base62 [a-zA-Z0-9] -&gt; 62^7 ≈ 3.5 trillion combinations&#10;7 characters is comfortably enough for 6B+ URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="480" height="80" as="geometry" />
        </mxCell>

        <mxCell id="bandwidth" value="Bandwidth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bandwidth_body" value="Write: 40 x 500 bytes/sec ≈ 20 KB/s (negligible)&#10;Read: 4,000 x 500 bytes/sec ≈ 2 MB/s (negligible)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="480" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cache_est" value="Cache Sizing (80/20 rule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cache_est_body" value="20% of URLs generate 80% of traffic. Cache ~20% of daily reads: (10B/month / 30) x 0.2 ≈ 67M records/day x 500 bytes ≈ ~35 GB — fits comfortably in a Redis cluster." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1000" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 3: API DESIGN -->
  <diagram name="3. API Design" id="page-api">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title3" value="TinyURL — API Design" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="api1_h" value="POST /api/v1/shorten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=13;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="api1_b" value="Request body: { long_url, custom_alias (optional), expiry_date (optional) }&#10;Response: { short_url: &quot;https://tiny.url/abc1234&quot; }&#10;Creates a new short URL. Applies rate limiting to prevent abuse." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1000" height="80" as="geometry" />
        </mxCell>

        <mxCell id="api2_h" value="GET /{short_code}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="api2_b" value="Response: 301 (permanent, cacheable) or 302 (temporary, forces hit for analytics) redirect to long_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1000" height="60" as="geometry" />
        </mxCell>

        <mxCell id="api3_h" value="DELETE /api/v1/{short_code}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=13;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="api3_b" value="Response: 204 No Content. Deletes the mapping (owner/auth check applies)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1000" height="60" as="geometry" />
        </mxCell>

        <mxCell id="api4_h" value="GET /api/v1/{short_code}/stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=13;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="api4_b" value="Response: { clicks, created_at, last_accessed }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;align=left;spacingLeft=10;spacingTop=10;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="1000" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

