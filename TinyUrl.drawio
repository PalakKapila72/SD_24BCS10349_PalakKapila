        <!-- Relationships -->
        <mxCell id="rel1" value="1..N" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;fontSize=11;" edge="1" parent="1" source="users_table" target="url_table">
