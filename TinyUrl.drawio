        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="analytics" target="analyticsdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="write-through" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="app" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Read path: Client -&gt; LB -&gt; App -&gt; Cache (hit) -&gt; Redirect (301/302). DB hit only on cache miss.&#10;Write path: Client -&gt; LB -&gt; App -&gt; KGS (get key) -&gt; DB write -&gt; Cache warm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="580" width="700" height="60" as="geometry" />
        </mxCell>

      </root>
