        <mxCell id="an4c2" value="TEXT" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="an4">
          <mxGeometry x="160" width="160" height="30" as="geometry" />
