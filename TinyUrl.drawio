  <!-- PAGE 5: ARCHITECTURE -->
  <diagram name="5. Architecture" id="page-architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title5" value="TinyURL — High Level Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="client" value="Client / Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="lb" value="Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="160" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="app" value="Application Servers&#10;(shorten + redirect logic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="260" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="kgs" value="Key Generation Service&#10;(pre-generates unique keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="370" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cache" value="Cache (Redis)&#10;hot short codes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="370" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="db" value="Database&#10;URL records (NoSQL / SQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="480" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="analytics" value="Analytics Service&#10;async click logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="370" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="analyticsdb" value="Analytics Store&#10;time-series DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="480" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="client" target="lb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="lb" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="on write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="app" target="kgs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="cache lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="app" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="on cache miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="cache" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="log click" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="app" target="analytics">
          <mxGeometry relative="1" as="geometry" />
