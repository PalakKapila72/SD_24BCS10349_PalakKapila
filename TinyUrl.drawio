        <mxCell id="an4" style="shape=tableRow;horizontal=0;startSize=0;fillColor=#FFFFFF;strokeColor=#E11D48;" vertex="1" parent="an_table">
          <mxGeometry y="120" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="an4c1" value="referrer / user_agent" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="an4">
          <mxGeometry width="160" height="30" as="geometry" />
